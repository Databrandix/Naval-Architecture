# Build-time credentials for name-deploy.service.
#
#   sudo install -d -o root -g root -m 0700 /etc/name-platform
#   sudo install -o root -g root -m 0600 /dev/null /etc/name-platform/build.env
#   sudo nano /etc/name-platform/build.env
#
# Root-owned, mode 0600. systemd reads it as root before dropping to
# User=name-build, so the build gets these values in its environment while the
# build account can never read the file itself.
#
# ONLY these two keys belong here. The build prerenders database-backed pages,
# so it needs Postgres; it has no use for BETTER_AUTH_SECRET, CLOUDINARY_*,
# RESEND_API_KEY or INITIAL_SUPER_ADMIN_PASSWORD, and those stay in the
# runtime-only .env.production.
#
# Plain KEY=value lines only: systemd does not evaluate `export`, shell
# expansion, or multi-line values, and treats a trailing `# comment` after a
# value as part of the value.
#
# The database is the LOCAL PostgreSQL 18 cluster on port 5433 -- not 5432,
# which belongs to su.edu.bd and must never appear here. There is no connection
# pooler in front of it, so DIRECT_URL is the same URL; Prisma still requires
# the key because the schema declares `directUrl`.
#
# Use the build role, not the runtime role: name_build has SELECT and nothing
# else, which is all a build needs.

DATABASE_URL=postgresql://name_build:PASSWORD@127.0.0.1:5433/name_platform
DIRECT_URL=postgresql://name_build:PASSWORD@127.0.0.1:5433/name_platform
